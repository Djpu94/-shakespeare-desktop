{
  "name": "@shakespeare/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicación de escritorio para escribir y organizar proyectos.",
  "author": "Shakespeare",
  "desktopName": "shakespeare.desktop",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"wait-on dist/main.js && cross-env SHAKESPEARE_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@shakespeare/domain": "workspace:*",
    "@shakespeare/infra": "workspace:*",
    "@shakespeare/shared": "workspace:*"
  },
  "devDependencies": {
    "@shakespeare/renderer": "workspace:*",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "^26.18.0",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.shakespeare.desktop",
    "productName": "Shakespeare",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "shakespeare",
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true
    }
  }
}
